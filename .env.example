# Server-only (Vercel + local .env for dev proxy — never expose as VITE_* except Maps JS key)
AI_API_URL=https://python-backend-270384591051.europe-west3.run.app
GATEWAY_CLIENT_API_KEY=your_client_api_key_here

# Client Maps JavaScript API key (restrict by HTTP referrer in Google Cloud Console)
# Enable: Maps JavaScript API, Directions API, Places API, Street View Static API, Maps Static API
VITE_GOOGLE_MAPS_API_KEY=your_browser_restricted_maps_key